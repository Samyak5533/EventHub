# Copy this file to .env and change what you need. Everything is optional.

PORT=3000

# Admin account created on first start (only if no admin exists yet).
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@eventhub.com
ADMIN_PASSWORD=admin123

# Secrets for login tokens and ticket QR signatures.
# Leave empty to auto-generate them into data/secrets.json on first run.
JWT_SECRET=
TICKET_SECRET=

# Stripe card payments (optional). Use a test key from
# https://dashboard.stripe.com/test/apikeys. Without it, Demo Payment still works.
STRIPE_SECRET_KEY=
# Public URL Stripe redirects back to. Defaults to the URL you opened the site on.
BASE_URL=

# Where the SQLite database and generated secrets live.
# DATA_DIR=./data

# Demo user account shown in the login hint. Set DEMO_EMAIL= (empty) to skip it.
DEMO_NAME=Demo User
DEMO_EMAIL=demo@eventhub.com
DEMO_PASSWORD=demo123
